@model Price_Quotation_App.Models.PriceQuotationPageViewModel

@{
    ViewData["Title"] = "Price Quotation";
}

<div class="container-fluid px-0">
    <div class="bg-success text-white rounded py-5 text-center">
        <h1 class="h2 m-0 fw-bold">
            <img src="~/images/coin.png"
                 alt="Coin Icon"
                 class="header-icon" />
            <span>Price Quotation</span>
        </h1>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <form asp-action="Index"
                      method="post"
                      class="mt-4">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger"></div>

                    <div class="row mb-3 align-items-center">
                        <label asp-for="Quote.Subtotal"
                               class="col-sm-4 col-form-label">
                            Sales Price
                        </label>

                        <div class="col-sm-4">
                            <input asp-for="Quote.Subtotal"
                                   class="form-control" />
                        </div>

                        <div class="col-sm-4">
                            <span asp-validation-for="Quote.Subtotal"
                                  class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3 align-items-center">
                        <label asp-for="Quote.DiscountPercent"
                               class="col-sm-4 col-form-label">
                            Discount Percent
                        </label>

                        <div class="col-sm-4">
                            <input asp-for="Quote.DiscountPercent"
                                   class="form-control" />
                        </div>

                        <div class="col-sm-4">
                            <span asp-validation-for="Quote.DiscountPercent"
                                  class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-4 col-form-label">
                            Discount Amount
                        </label>

                        <div class="col-sm-4">
                            <input value="@Model.Quote.DiscountAmount.ToString("C")"
                                   class="form-control"
                                   readonly />
                        </div>
                    </div>

                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-4 col-form-label">
                            Total
                        </label>

                        <div class="col-sm-4">
                            <input value="@Model.Quote.Total.ToString("C")"
                                   class="form-control"
                                   readonly />
                        </div>
                    </div>

                    <div class="row">
                        <div class="offset-sm-4 col-sm-8">
                            <button type="submit"
                                    class="btn btn-success me-2">
                                Save Quote
                            </button>

                            <a asp-action="Index"
                               asp-route-slug=""
                               class="btn btn-secondary">
                                Clear
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <h2 class="h4 mt-4">Previous Price Quotes</h2>

        @if (Model.PreviousQuotes.Count == 0)
        {
            <p>No previous quotes yet.</p>
        }
        else
        {
            <ul class="list-group mb-4">
                @foreach (var quote in Model.PreviousQuotes)
                {
                    <li class="list-group-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-route-slug="@quote.Slug">
                            @quote.CreatedAtUtc.ToLocalTime().ToString("g")
                            — @quote.Subtotal.ToString("C")
                            — @quote.DiscountPercent% discount
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}